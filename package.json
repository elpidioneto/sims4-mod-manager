    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
